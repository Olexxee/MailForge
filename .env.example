NODE_ENV=development
APP_NAME=MailForge
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://mailforge:mailforge@localhost:5432/mailforge?schema=public
CREDENTIAL_ENCRYPTION_KEYS_JSON="{\"1\":\"REPLACE_WITH_BASE64_32_BYTE_KEY\"}"
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_VERSION=1

# Initial owner bootstrap only; supply temporarily when running the CLI, never commit real values.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ORGANISATION_NAME=
BOOTSTRAP_ORGANISATION_SLUG=

VITE_API_URL=http://localhost:4000/api/v1

# GO54 Cloud Mail endpoints shown in the account's Secure SSL/TLS Settings.
# Hostnames are server-side configuration; the mailbox password is entered in the admin UI,
# encrypted with the credential keyring, and stored in PostgreSQL. Never put it here.
GO54_IMAP_HOST=imap.go54mail.com
GO54_IMAP_PORT=993
GO54_SMTP_HOST=smtp.go54mail.com
GO54_SMTP_PORT=587
