NODE_ENV=development
APP_NAME=MailForge
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://mailforge:mailforge@localhost:5432/mailforge?schema=public
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-key-material

# Initial owner bootstrap only; supply temporarily when running the CLI, never commit real values.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ORGANISATION_NAME=
BOOTSTRAP_ORGANISATION_SLUG=
