NODE_ENV=development
APP_NAME=MailForge
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://mailforge:mailforge@localhost:5432/mailforge?schema=public
CREDENTIAL_ENCRYPTION_KEYS_JSON="{\"1\":\"REPLACE_WITH_BASE64_32_BYTE_KEY\"}"
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_VERSION=1

# Initial owner bootstrap only; supply temporarily when running the CLI, never commit real values.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_ORGANISATION_NAME=
BOOTSTRAP_ORGANISATION_SLUG=

VITE_API_URL=http://localhost:4000/api/v1

# Obtain the exact GO54 mail server hostnames for this mailbox/account before validation.
# These are server-side configuration values; they are never accepted from the browser.
GO54_IMAP_HOST=
GO54_IMAP_PORT=993
GO54_SMTP_HOST=
GO54_SMTP_PORT=465
