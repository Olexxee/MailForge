generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum DomainStatus {
  PENDING
  VERIFIED
}

enum ProviderType {
  GO54
}

enum ProviderAuthType {
  PASSWORD
}

enum ProtocolStatus {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
}

enum MailboxStatus {
  ACTIVE
  DISABLED
}

enum MailboxPermission {
  READ
  SEND
  MANAGE
  ADMINISTER
}

model User {
  id                String                    @id @default(cuid())
  email             String                    @unique
  passwordHash      String
  displayName       String
  isActive          Boolean                   @default(true)
  sessions          Session[]
  memberships       OrganizationMembership[]
  createdInvitations OrganizationInvitation[] @relation("InvitationInviter")
  auditEvents       AuditLog[]                @relation("AuditActor")
  mailboxAccess     MailboxAccess[]            @relation("MailboxAccessUser")
  grantedAccess     MailboxAccess[]            @relation("MailboxAccessGrantor")
  createdDomains    Domain[]                   @relation("DomainCreator")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model Session {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  csrfTokenHash String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, expiresAt])
}

model Organisation {
  id          String                    @id @default(cuid())
  name        String
  slug        String                    @unique
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  auditLogs   AuditLog[]
  domains     Domain[]
  providerConnections ProviderConnection[]
  mailboxes   Mailbox[]
  mailboxAccess MailboxAccess[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  organisationId String
  userId         String
  role           MembershipRole @default(STAFF)
  isActive       Boolean        @default(true)
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organisationId, userId])
  @@index([userId, isActive])
}

model OrganizationInvitation {
  id             String         @id @default(cuid())
  organisationId String
  email          String
  role           MembershipRole
  tokenHash      String         @unique
  inviterId      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  inviter        User           @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())

  @@index([organisationId, email, expiresAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
  @@index([actorId, createdAt])
}


model Domain {
  id                String       @id @default(cuid())
  organisationId    String
  name              String
  verificationToken String
  status            DomainStatus @default(PENDING)
  verifiedAt        DateTime?
  createdById       String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy         User         @relation("DomainCreator", fields: [createdById], references: [id], onDelete: Restrict)
  mailboxes         Mailbox[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organisationId, name])
  @@unique([id, organisationId])
  @@index([organisationId, status])
}

model ProviderConnection {
  id                    String           @id @default(cuid())
  organisationId        String
  providerType          ProviderType
  authType              ProviderAuthType @default(PASSWORD)
  accountEmail          String
  encryptedCredentials  String
  credentialKeyVersion  Int
  imapStatus            ProtocolStatus   @default(UNKNOWN)
  smtpStatus            ProtocolStatus   @default(UNKNOWN)
  lastCheckedAt         DateTime?
  lastSafeErrorCode     String?
  organisation          Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mailboxes             Mailbox[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([organisationId, providerType, accountEmail])
  @@unique([id, organisationId])
  @@index([organisationId, providerType])
}

model Mailbox {
  id                  String           @id @default(cuid())
  organisationId      String
  domainId            String
  providerConnectionId String
  email               String
  displayName         String?
  status              MailboxStatus    @default(ACTIVE)
  organisation        Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  domain              Domain           @relation(fields: [domainId, organisationId], references: [id, organisationId], onDelete: Restrict)
  providerConnection  ProviderConnection @relation(fields: [providerConnectionId, organisationId], references: [id, organisationId], onDelete: Restrict)
  accessGrants        MailboxAccess[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organisationId, email])
  @@unique([id, organisationId])
  @@index([organisationId, status])
  @@index([providerConnectionId])
}

model MailboxAccess {
  id             String            @id @default(cuid())
  organisationId String
  mailboxId      String
  userId         String
  permission     MailboxPermission
  grantedById    String
  revokedAt      DateTime?
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mailbox        Mailbox            @relation(fields: [mailboxId, organisationId], references: [id, organisationId], onDelete: Cascade)
  user           User               @relation("MailboxAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy      User               @relation("MailboxAccessGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([mailboxId, userId])
  @@index([organisationId, userId, revokedAt])
  @@index([mailboxId, revokedAt])
}
